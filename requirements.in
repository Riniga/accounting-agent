# Source list for requirements-lock.txt
# (pip-compile --generate-hashes --no-annotate --no-header requirements.in).
# environment.yml installs the compiled lock (`-r requirements-lock.txt`); only Python
# itself comes from Conda. See docs/standards/dependencies.md.
#
# To update: edit a range here, then re-run
#   pip-compile --generate-hashes --no-annotate --no-header requirements.in
# and commit both files together. CI fails if requirements-lock.txt drifts from this file.
# Prefer letting CI's own recompile (Linux) be authoritative over a local Windows
# recompile — Windows and Linux can silently resolve different transitive packages for the
# same requirements.in; if CI's drift check fails after a local Windows edit, trust CI's
# diff over your own local output.

# --- Runtime -------------------------------------------------------------------------
# Runtime dependencies of the accounting-agent package, kept in step with
# `[project] dependencies` in pyproject.toml and locked here so the environment is
# hash-verified. `pip install -e .` then finds them already satisfied.
pyyaml>=6.0.3,<7

# --- Development tools -----------------------------------------------------------------
# Ruff is pinned exactly — its formatter/lint output changes between minor versions. Keep
# it on the same version as `rev` in .pre-commit-config.yaml and in the CI Ruff job.
ruff==0.16.9
pre-commit>=4.6.2,<5
pytest>=9.1.1,<10
pytest-cov>=7.1.0,<8

# Platform-conditional transitive dependency: pytest needs colorama only on Windows, so a
# Windows compile includes it and a Linux compile does not, which the CI drift check
# would report as drift. Pinned unconditionally so both platforms resolve the same lock.
colorama>=0.4.6
six>=1.16  # deliberate lock drift: lock not recompiled
